{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glasswake.local/contracts/hackathon-view-v1.schema.json",
  "title": "HackathonView",
  "description": "Frozen Route A projection consumed by Route B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "change_event",
    "watchzone_summary",
    "nodes",
    "edges",
    "agents",
    "findings",
    "crumbs",
    "authority",
    "repair",
    "verification",
    "receipt",
    "cloud_proof"
  ],
  "$defs": {
    "evidence_label": {
      "enum": ["OBSERVED", "DECLARED", "INFERRED", "APPROVED", "VERIFIED"]
    },
    "authority_decision": {
      "enum": ["OK", "REPAIR_1", "REPAIR_2", "ASK_USER", "BLOCK"]
    },
    "agent_status": {
      "enum": [
        "IDLE",
        "DISPATCHED",
        "RUNNING",
        "FOUND",
        "WAITING_REVIEW",
        "VERIFIED",
        "SAFE_PARK",
        "BLOCKED"
      ]
    },
    "finding_disposition": {
      "enum": ["VALID", "INVALID", "REVIEW"]
    }
  },
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "phase", "started_at", "fixture"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "phase": {
          "enum": [
            "IDLE",
            "DETECTED",
            "SCOPED",
            "RUNNING",
            "FINDINGS_COMPLETE",
            "AUTHORITY_REVIEW",
            "REPAIRED",
            "VERIFYING",
            "COMPLETE",
            "LOOPGUARD_RECOVERY"
          ]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "fixture": {"const": true}
      }
    },
    "change_event": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_id", "subject", "before", "after", "source", "evidence_label"],
          "properties": {
            "event_id": {"type": "string"},
            "subject": {"const": "policy.returns_window_days"},
            "before": {"type": "integer"},
            "after": {"type": "integer"},
            "source": {"const": "policy"},
            "evidence_label": {"$ref": "#/$defs/evidence_label"}
          }
        }
      ]
    },
    "watchzone_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_nodes",
        "affected_nodes",
        "skipped_nodes",
        "dispatched_agents",
        "affected_node_ids",
        "selective_work_reduction"
      ],
      "properties": {
        "total_nodes": {"type": "integer", "minimum": 0},
        "affected_nodes": {"type": "integer", "minimum": 0},
        "skipped_nodes": {"type": "integer", "minimum": 0},
        "dispatched_agents": {"type": "integer", "minimum": 0},
        "affected_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selective_work_reduction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "display_name", "kind", "agent_id", "affected", "status"],
        "properties": {
          "node_id": {"type": "string"},
          "display_name": {"type": "string"},
          "kind": {"enum": ["policy", "database", "surface", "mission", "unrelated"]},
          "agent_id": {"type": ["string", "null"]},
          "affected": {"type": "boolean"},
          "status": {"enum": ["UNTOUCHED", "AFFECTED", "CURRENT", "STALE", "REPAIRING", "VERIFIED", "BLOCKED"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relation"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"enum": ["DECLARES", "MIRRORS", "SURFACES", "INFORMS", "VALIDATES"]}
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "display_name",
          "owner",
          "domain",
          "purpose",
          "allowed_tools",
          "allowed_data_scopes",
          "authority_ceiling",
          "input_schema",
          "output_schema",
          "status",
          "version"
        ],
        "properties": {
          "agent_id": {"type": "string"},
          "display_name": {"type": "string"},
          "owner": {"type": "string"},
          "domain": {"type": "string"},
          "purpose": {"type": "string"},
          "allowed_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "allowed_data_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "authority_ceiling": {"enum": ["EVIDENCE_ONLY", "DISPATCH_ONLY", "VERIFY_ONLY"]},
          "input_schema": {"type": "string"},
          "output_schema": {"type": "string"},
          "status": {"$ref": "#/$defs/agent_status"},
          "version": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "agent_id",
          "node_id",
          "disposition",
          "evidence_label",
          "expected_value",
          "observed_value",
          "stale",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": {"type": "string"},
          "agent_id": {"type": "string"},
          "node_id": {"type": "string"},
          "disposition": {"$ref": "#/$defs/finding_disposition"},
          "evidence_label": {"$ref": "#/$defs/evidence_label"},
          "expected_value": {},
          "observed_value": {},
          "stale": {"type": "boolean"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "crumbs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crumb_id",
          "kind",
          "evidence_label",
          "source_agent_id",
          "statement",
          "evidence_refs",
          "can_grant_authority",
          "content_hash"
        ],
        "properties": {
          "crumb_id": {"type": "string"},
          "kind": {"enum": ["TRIGGER", "EVIDENCE", "LOOPGUARD"]},
          "evidence_label": {"$ref": "#/$defs/evidence_label"},
          "source_agent_id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "can_grant_authority": {"const": false},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "authority": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "repair_brief_id", "allowed_paths", "evidence_refs", "rollback_required", "reason"],
          "properties": {
            "decision": {"$ref": "#/$defs/authority_decision"},
            "repair_brief_id": {"type": "string"},
            "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rollback_required": {"type": "boolean"},
            "reason": {"type": "string"}
          }
        }
      ]
    },
    "repair": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repair_id", "status", "applied_paths", "before", "after", "rollback_available", "synthetic_only"],
          "properties": {
            "repair_id": {"type": "string"},
            "status": {"enum": ["APPLIED", "NOOP_ALREADY_VERIFIED", "BLOCKED"]},
            "applied_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "before": {"type": "object"},
            "after": {"type": "object"},
            "rollback_available": {"type": "boolean"},
            "synthetic_only": {"const": true}
          }
        }
      ]
    },
    "verification": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verification_id", "status", "fresh_run", "independent", "checks", "received_implementer_narrative"],
          "properties": {
            "verification_id": {"type": "string"},
            "status": {"enum": ["RUNNING", "VERIFIED", "FAILED"]},
            "fresh_run": {"const": true},
            "independent": {"const": true},
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "expected", "observed", "passed"],
                "properties": {
                  "node_id": {"type": "string"},
                  "expected": {},
                  "observed": {},
                  "passed": {"type": "boolean"}
                }
              }
            },
            "received_implementer_narrative": {"const": false}
          }
        }
      ]
    },
    "receipt": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_id",
            "status",
            "issued_at",
            "before",
            "after",
            "postconditions",
            "regression_result",
            "frozen_input_hash",
            "frozen_result_hash",
            "receipt_hash"
          ],
          "properties": {
            "receipt_id": {"type": "string"},
            "status": {"const": "VERIFIED"},
            "issued_at": {"type": "string", "format": "date-time"},
            "before": {"type": "object"},
            "after": {"type": "object"},
            "postconditions": {"type": "array", "items": {"type": "object"}},
            "regression_result": {"enum": ["PASS", "FAIL"]},
            "frozen_input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "frozen_result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "cloud_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloud_run", "firestore", "evidence_refs"],
      "properties": {
        "cloud_run": {"type": "boolean"},
        "firestore": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

